@page "/todos"
@using Microsoft.AspNetCore.Authorization
@using Wolverine
@using MIF.SharedKernel.Application
@using MIF.Modules.Todos.Application.DTOs
@using MIF.Modules.Todos.Application.Queries
@using MIF.Modules.Todos.Application.Commands
@using MIF.Modules.Todos.Domain
@* @attribute [Authorize] *@
@inject IMessageBus Bus


<PageTitle>Todos</PageTitle>

<h2>Todo List</h2>

<TelerikCard>
    <CardHeader>
        <CardTitle>Add New Todo</CardTitle>
    </CardHeader>
    <CardBody>
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;" @onkeydown="HandleKeyDown">
            <TelerikTextBox @bind-Value="newTodoTitle"
                            Placeholder="New Todo"
                            Width="200px" />
            <TelerikTextBox @bind-Value="newTodoAssignedTo"
                            Placeholder="Assigned To"
                            Width="200px" />
            <TelerikDropDownList TItem="ImportanceOption"
                                 TValue="Importance"
                                 @bind-Value="newTodoImportance"
                                 Data="importanceLevels"
                                 TextField="Text"
                                 ValueField="Value"
                                 Width="140px" />
            <TelerikButton OnClick="AddTodo" ThemeColor="Primary">Add Task</TelerikButton>
        </div>
    </CardBody>
</TelerikCard>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div style="background:#f8d7da;color:#842029;padding:12px 16px;border-radius:4px;margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center;">
        <span>@errorMessage</span>
        <TelerikButton OnClick="ClearError" ThemeColor="Base" FillMode="flat">✕</TelerikButton>
    </div>
}

<TelerikGrid Data="@todos"
             TItem="TodoItemDto"
             Pageable="true"
             Sortable="true"
             PageSize="@pageSize"
             EditMode="@GridEditMode.Inline"
             OnUpdate="OnUpdateHandler"
             OnDelete="OnDeleteHandler">
    <GridColumns>
        <GridColumn Field="@nameof(TodoItemDto.IsCompleted)" Title="Done" Width="80px" Editable="false">
            <Template Context="item">
                @{ var todo = (TodoItemDto)item; }
                <TelerikCheckBox Value="@todo.IsCompleted"
                                 ValueChanged="@(async (bool _) => await ToggleTodo(todo.Id))"
                                 ValueExpression="@(() => todo.IsCompleted)" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(TodoItemDto.Title)" Title="Title" />
        <GridColumn Field="@nameof(TodoItemDto.AssignedTo)" Title="Assigned To" />
        <GridColumn Field="@nameof(TodoItemDto.Importance)" Title="Importance">
            <Template Context="item">
                @{ var importanceItem = (TodoItemDto)item; }
                @importanceItem.Importance
            </Template>
            <EditorTemplate Context="item">
                @{ var editItem = (TodoItemDto)item; }
                <TelerikDropDownList TItem="ImportanceOption"
                                     TValue="Importance"
                                     @bind-Value="editItem.Importance"
                                     Data="importanceLevels"
                                     TextField="Text"
                                     ValueField="Value" />
            </EditorTemplate>
        </GridColumn>
        <GridCommandColumn>
            <GridCommandButton Command="Edit" ThemeColor="Primary">Edit</GridCommandButton>
            <GridCommandButton Command="Delete" ThemeColor="Error">Delete</GridCommandButton>
            <GridCommandButton Command="Save" ThemeColor="Success" ShowInEdit="true">Save</GridCommandButton>
            <GridCommandButton Command="Cancel" ShowInEdit="true">Cancel</GridCommandButton>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>

@code {
    private List<TodoItemDto> todos = new();

    private class ImportanceOption
    {
        public string Text { get; init; } = string.Empty;
        public Importance Value { get; init; }
    }

    private readonly List<ImportanceOption> importanceLevels =
    [
        new() { Text = "Low", Value = Importance.Low },
        new() { Text = "Medium", Value = Importance.Medium },
        new() { Text = "High", Value = Importance.High }
    ];

    private string newTodoTitle = string.Empty;
    private string newTodoAssignedTo = string.Empty;
    private Importance newTodoImportance = Importance.Medium;
    private int pageSize = 10;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        try
        {
            var result = await Bus.InvokeAsync<Result<PaginatedList<TodoItemDto>>>(
                new GetTodosQuery(1, int.MaxValue));

            if (result.IsSuccess && result.Value != null)
            {
                todos = result.Value.Items;
                errorMessage = null;
            }
            else
            {
                errorMessage = result.Error.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading todos: {ex.Message}";
        }
    }

    private async Task AddTodo()
    {
        if (!string.IsNullOrWhiteSpace(newTodoTitle) && !string.IsNullOrWhiteSpace(newTodoAssignedTo))
        {
            try
            {
                var result = await Bus.InvokeAsync<Result<int>>(
                    new CreateTodoCommand(newTodoTitle, newTodoAssignedTo, newTodoImportance));

                if (result.IsSuccess)
                {
                    newTodoTitle = string.Empty;
                    newTodoAssignedTo = string.Empty;
                    newTodoImportance = Importance.Medium;
                    errorMessage = null;
                    await LoadTodos();
                }
                else
                {
                    errorMessage = result.Error.Message;
                }
            }
            catch (FluentValidation.ValidationException validationEx)
            {
                errorMessage = string.Join("; ", validationEx.Errors.Select(e => e.ErrorMessage));
            }
            catch (Exception ex)
            {
                errorMessage = $"Error adding todo: {ex.Message}";
            }
        }
        else
        {
            errorMessage = "Title and Assigned To are required.";
        }
    }

    private async Task ToggleTodo(int id)
    {
        try
        {
            var result = await Bus.InvokeAsync<Result>(new ToggleTodoCommand(id));

            if (result.IsSuccess)
            {
                errorMessage = null;
                await LoadTodos();
            }
            else
            {
                errorMessage = result.Error.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error toggling todo: {ex.Message}";
        }
    }

    private async Task OnUpdateHandler(GridCommandEventArgs args)
    {
        var todo = (TodoItemDto)args.Item;
        try
        {
            var result = await Bus.InvokeAsync<Result>(
                new UpdateTodoCommand(todo.Id, todo.Title, todo.AssignedTo, todo.Importance));

            if (result.IsSuccess)
            {
                errorMessage = null;
                await LoadTodos();
            }
            else
            {
                errorMessage = result.Error.Message;
            }
        }
        catch (FluentValidation.ValidationException validationEx)
        {
            errorMessage = string.Join("; ", validationEx.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating todo: {ex.Message}";
        }
    }

    private async Task OnDeleteHandler(GridCommandEventArgs args)
    {
        var todo = (TodoItemDto)args.Item;
        try
        {
            var result = await Bus.InvokeAsync<Result>(new DeleteTodoCommand(todo.Id));

            if (result.IsSuccess)
            {
                errorMessage = null;
                await LoadTodos();
            }
            else
            {
                errorMessage = result.Error.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting todo: {ex.Message}";
        }
    }

    private Task ClearError()
    {
        errorMessage = null;
        return Task.CompletedTask;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTodo();
        }
    }
}